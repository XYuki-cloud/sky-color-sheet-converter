.ruff_cache/

# Codex desktop state and attached media
.codex/
.codex-remote-attachments/

# Windows shortcuts are machine-specific and are not source artifacts.
*.lnk

# User-provided source material stays local; use examples/ for tracked fixtures.
待转谱/*
